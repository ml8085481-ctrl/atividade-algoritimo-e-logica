programa {
  funcao inicio() {
    inteiro senha
    inteiro tentativas
    tentativas = 0
    enquanto(tentativas = 3)
    escreva("digite a senha ")
    leia(senha )
    se (senha = 2025){
     escreva(" acesso liberado")
     senao 
     tentativas = tentativas + 1
    } se (senha <> 2025){
      escreva("acesso negado")
    }
  }
}
